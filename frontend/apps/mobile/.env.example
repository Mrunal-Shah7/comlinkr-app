# Google OAuth (native Google Sign-In — requires a development/production build, not Expo Go)
# webClientId is required on Android to return an idToken for the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Nest API base (no /v1 — global prefix is `api` only)
# Simulator/emulator: localhost is OK. Physical phone: use your PC's LAN IP, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api
# For ngrok tunnel: https://YOUR_NGROK_ID.ngrok-free.app/api
EXPO_PUBLIC_API_BASE_URL=https://api.comlinkr.com/api

EXPO_PUBLIC_JWT_STORAGE_KEY=comlinkr_jwt
EXPO_PUBLIC_REFRESH_TOKEN_KEY=comlinkr_refresh
